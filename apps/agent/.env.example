# Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Optional: Create one with @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# NosHen Engine Base URL (defaults to production live demo or localhost)
NOSHEN_API_URL=https://noshen-web.usenoshen.workers.dev

# The key for the NosHen site's assistant API (AGENT_API_KEY in apps/web/.dev.vars): lets people link their
# NosHen account with /link on Telegram and see their wallet and deals. Leave empty to switch that off.
NOSHEN_AGENT_KEY=

# eBay Browse API, for live eBay listings (Optional: the App ID and Cert ID of a Production keyset from developer.ebay.com).
# Without them the agent sends a link to the same search on eBay's website.
EBAY_APP_ID=
EBAY_CERT_ID=

# Jev AI fraud check (Optional: a TypeSafe AI key, starting with jv_). Without it the check isn't offered.
JEV_API_KEY=
