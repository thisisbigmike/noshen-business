{
  "name": "@noshen/agent",
  "version": "1.0.0",
  "type": "module",
  "description": "NosHen shopping assistant powered by Google Gemini: live NosHen and eBay listings, and answers from NosHen's help pages.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "telegram": "tsx src/index.ts --telegram",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@noshen/engine": "workspace:*",
    "@noshen/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
