/**
 * The customer site (noshen.com): buying, selling and deals. See README.md for the production setup.
 * The staff site is a separate Worker (apps/admin) with its own address, secrets and database login.
 * Local development: `pnpm dev` from the repo root.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noshen-web",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Run the Worker near the database (Neon, London), not near each user.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "APP_URL": "http://localhost:5173",
    // "fake" until the payment partner is chosen; see server/partner/.
    "PARTNER": "fake",
    "PARTNER_BANK_NAME": "Test Bank (fake partner)",
    // "console" prints emails to the log and shows sign-in codes on screen in development.
    "EMAIL": "console",
    // NIN/BVN checks: "fake" (any 11 digits pass), "dojah-sandbox" (Dojah's free test service: NIN 70123456789,
    // BVN 22222222222) or "dojah" (real checks, paid per check). Dojah needs the secrets DOJAH_APP_ID and DOJAH_SECRET_KEY.
    "ID_PROVIDER": "fake",
    // NosHen's own Solana wallet on devnet (pnpm solana:setup). Secrets: SOLANA_RPC_URL (a keyed RPC: Solana's public one refuses Workers), SOLANA_WALLET, SOLANA_DEMO_WALLET, SOLANA_DEPOSIT_SECRET.
    "SOLANA_USDC_MINT": "J7sNd4p3yWKQwsYChizSTJtMTZbWPY9rKNfKHUTbTm5",
    "SOLANA_USDT_MINT": "BnWKpnFbmAcSsrtnSL3djPHbKSe9aHUJLqBysYu329Ht"
  },
  // Production: `wrangler hyperdrive create noshen-web-db --connection-string=<noshen_web login> --caching-disabled`.
  // It connects as the customer site's own database login (noshen_web, see db/roles.sql), never the owner.
  // Query caching must stay off: money reads may never be stale (TRD, "Caching and load balancing").
  // Local: `pnpm dev` sets the connection from .dev.vars (scripts/dev.mjs).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/noshen"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "noshen-photos" }],
  "workflows": [{ "name": "noshen-deal-timers", "binding": "DEAL_TIMERS", "class_name": "DealTimers" }],
  // One live room per deal (workers/deal-room.ts): the buyer's and seller's open pages, connected by WebSocket.
  "durable_objects": { "bindings": [{ "name": "DEAL_ROOMS", "class_name": "DealRoom" }] },
  "migrations": [{ "tag": "deal-rooms-v1", "new_sqlite_classes": ["DealRoom"] }],
  // The stuck-deal sweep: the safety net behind every timer.
  "triggers": { "crons": ["0 * * * *"] },
  // The public demo: `pnpm deploy:web` builds with CLOUDFLARE_ENV=production and deploys this.
  // Bindings aren't inherited by environments, so they're all listed again here.
  "env": {
    "production": {
      "name": "noshen-web",
      "vars": {
        "APP_URL": "https://noshen-web.usenoshen.workers.dev",
        // Pretend payments and ID checks: a demo, not the real service (the site says so on every page).
        "PARTNER": "fake",
        "PARTNER_BANK_NAME": "Test Bank (demo)",
        // No email provider until there's a domain: sign-in is by Google, and updates are in the app.
        "EMAIL": "none",
        // "fake" until Dojah is live (see the comment on ID_PROVIDER above).
        "ID_PROVIDER": "fake",
        // NosHen's own Solana wallet on devnet (pnpm solana:setup). Secrets: SOLANA_RPC_URL (a keyed RPC: Solana's public one refuses Workers), SOLANA_WALLET, SOLANA_DEMO_WALLET, SOLANA_DEPOSIT_SECRET.
        "SOLANA_USDC_MINT": "J7sNd4p3yWKQwsYChizSTJtMTZbWPY9rKNfKHUTbTm5",
        "SOLANA_USDT_MINT": "BnWKpnFbmAcSsrtnSL3djPHbKSe9aHUJLqBysYu329Ht",
        // Phone notifications (Web Push): the public key browsers subscribe with. Its private half is the secret VAPID_PRIVATE_JWK.
        "VAPID_PUBLIC_KEY": "BN2iM4wO9eZDlmuNBOiTOgbyGsIyeSnQjYLBQCKHs8UBm0i0_jjcjJ-1Gwsm0P39c6L9eDVxoCgzVrnDtM-Mucg"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "6e865a502a8e457bb56922a1a5d7f806" }],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "noshen-photos" }],
      "workflows": [{ "name": "noshen-deal-timers", "binding": "DEAL_TIMERS", "class_name": "DealTimers" }],
      "durable_objects": { "bindings": [{ "name": "DEAL_ROOMS", "class_name": "DealRoom" }] },
      // The staff site, to send staff alerts at once (it alone may read staff devices). See engine/staff-alerts.ts.
      "services": [{ "binding": "STAFF_SITE", "service": "noshen-admin" }],
      "triggers": { "crons": ["0 * * * *"] }
    }
  }
}
