{
  "extends": "../../tsconfig.base.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "server/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "react-router.config.ts",
    "../../packages/*/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"]
  }
}
