# Copy to .dev.vars: the customer site's local secrets. Never commit .dev.vars.
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
RELEASE_CODE_SECRET=change-me
FAKE_PARTNER_SECRET=change-me
# 32 random bytes, base64: encrypts bank account numbers. The staff site uses the same value.
FIELD_KEY=change-me
# Google sign-in (optional): an OAuth client from Google Cloud with redirect URI <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NIN/BVN checks through Dojah (set ID_PROVIDER to "dojah-sandbox" or "dojah" in wrangler.jsonc): the App ID and
# secret key from the Dojah dashboard, Developers → Configuration. Sandbox and live keys are different.
# DOJAH_APP_ID=
# DOJAH_SECRET_KEY=
# Everyone's NosHen wallet, through Blockradar: each network's master wallet id and its API key (the key also signs
# the webhooks). Use testnet master wallets here; leave a network out to switch it off. Webhook URL in the Blockradar
# dashboard: <APP_URL>/api/webhooks/blockradar
# BLOCKRADAR_SOLANA_WALLET_ID=
# BLOCKRADAR_SOLANA_API_KEY=
# BLOCKRADAR_BASE_WALLET_ID=
# BLOCKRADAR_BASE_API_KEY=
# BLOCKRADAR_BSC_WALLET_ID=
# BLOCKRADAR_BSC_API_KEY=
