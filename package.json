{
  "name": "noshen",
  "private": true,
  "type": "module",
  "description": "NosHen: one repo, two sites. apps/web is the customer site, apps/admin the staff site; packages/ holds the shared engine, rules and UI.",
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "dev:admin": "node scripts/dev.mjs admin",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "deploy:web": "pnpm --filter @noshen/web run deploy",
    "deploy:admin": "pnpm --filter @noshen/admin run deploy",
    "typecheck": "pnpm -r --filter \"./apps/*\" typecheck && tsc -p tsconfig.node.json",
    "db:migrate": "node scripts/migrate.mjs",
    "db:roles": "node scripts/db-roles.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:test": "node scripts/db-test.mjs",
    "test": "vitest run",
    "staff:create": "node scripts/create-staff.mjs",
    "staff:password": "node scripts/staff-password.mjs",
    "solana:setup": "node packages/engine/scripts/solana-setup.mjs",
    "solana:keys": "node packages/engine/scripts/solana-keys.mjs",
    "evm:setup": "node packages/engine/scripts/evm-setup.mjs",
    "evm:keys": "node packages/engine/scripts/evm-keys.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@noshen/engine": "workspace:*",
    "@noshen/shared": "workspace:*",
    "@solana/kit": "8.4.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "viem": "2.57.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.6.0"
}
