# Copy to .dev.vars for local development. Never commit .dev.vars.
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
RELEASE_CODE_SECRET=change-me
FAKE_PARTNER_SECRET=change-me
# 32 random bytes, base64: encrypts bank account numbers
FIELD_KEY=change-me
# Used by the scripts in scripts/ (migrations, seed, staff); the Worker uses Hyperdrive instead
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/noshen
# Google sign-in (optional): an OAuth client from Google Cloud with redirect URI <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
