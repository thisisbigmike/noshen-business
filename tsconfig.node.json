{
  "extends": "./tsconfig.base.json",
  "include": [
    "vitest.config.ts",
    "tests/**/*",
    "packages/shared/src/**/*",
    "packages/engine/src/**/*",
    "apps/admin/server/access-jwt.ts"
  ],
  // These need the Workers runtime; each site's own check covers them.
  "exclude": ["packages/engine/src/context.ts", "packages/engine/src/photos.ts", "packages/engine/src/timers.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  }
}
